<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>de.marvin.jellyfin</groupId>
  <artifactId>jellyfin-pc</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.version>21.0.5</javafx.version>
    <!-- win fuer Windows; zum Testen auf Linux: -Djavafx.platform=linux -->
    <javafx.platform>win</javafx.platform>
  </properties>
  <dependencies>
    <dependency><groupId>org.openjfx</groupId><artifactId>javafx-base</artifactId><version>${javafx.version}</version><classifier>${javafx.platform}</classifier></dependency>
    <dependency><groupId>org.openjfx</groupId><artifactId>javafx-graphics</artifactId><version>${javafx.version}</version><classifier>${javafx.platform}</classifier></dependency>
    <dependency><groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId><version>${javafx.version}</version><classifier>${javafx.platform}</classifier></dependency>
    <dependency><groupId>org.json</groupId><artifactId>json</artifactId><version>20250517</version></dependency>
    <dependency><groupId>uk.co.caprica</groupId><artifactId>vlcj</artifactId><version>4.8.3</version></dependency>
    <dependency><groupId>uk.co.caprica</groupId><artifactId>vlcj-javafx</artifactId><version>1.1.0</version></dependency>
  </dependencies>
  <build>
    <finalName>JellyfinPC</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.0</version>
        <executions><execution><phase>package</phase><goals><goal>shade</goal></goals>
          <configuration>
            <createDependencyReducedPom>false</createDependencyReducedPom>
            <transformers><transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
              <mainClass>de.marvin.jellyfin.pc.Launcher</mainClass></transformer></transformers>
            <filters><filter><artifact>*:*</artifact><excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude><exclude>module-info.class</exclude></excludes></filter></filters>
          </configuration></execution></executions>
      </plugin>
      <plugin>
        <groupId>com.akathist.maven.plugins.launch4j</groupId><artifactId>launch4j-maven-plugin</artifactId><version>2.5.2</version>
        <executions><execution><id>l4j</id><phase>package</phase><goals><goal>launch4j</goal></goals>
          <configuration>
            <headerType>gui</headerType>
            <icon>src/main/resources/app.ico</icon>
            <outfile>target/JellyfinPC.exe</outfile>
            <jar>target/JellyfinPC.jar</jar>
            <errTitle>Jellyfin PC</errTitle>
            <jre><minVersion>17</minVersion><jdkPreference>preferJre</jdkPreference><opts><opt>-Dlaunch4j.exedir="%EXEDIR%"</opt></opts></jre>
          </configuration></execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
